    "command": "memcue search -in all \"tables plain lists phone formatting answers\"",
    "output": "No stored facts match.",
    "turn": 2
   },
   {
    "command": "memcue add -kind rule -scope global -source user -keywords \"tables, plain lists, phone, mobile, formatting, таблицы, списки, телефон\" -- \"The user reads answers mostly on a phone, where markdown tables are unreadable. Do not use tables in replies; use plain lists instead.\"",
    "output": "01M6EK5FMH30SSWRVFSADKPTYK",
    "turn": 2
   }
