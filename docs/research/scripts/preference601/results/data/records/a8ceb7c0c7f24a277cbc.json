    "command": "memcue search \"offsite announcement\"",
    "output": "No facts of this repository, this host or global match; -in all searches every repository.",
    "turn": 1
   },
   {
    "command": "memcue search -in all \"emoji\"",
    "output": "No stored facts match.",
    "turn": 2
   },
   {
    "command": "memcue add -kind rule -scope global -source user -keywords \"emoji, эмодзи, smileys, tone, writing style, announcements, drafts\" -- \"Never use emoji in anything written for the user or in their name (announcements, messages, drafts). The user finds them unprofessional.\"",
    "output": "01M6EK3MBRJTW6BC6ED6238433",
    "turn": 2
   }
  ]
