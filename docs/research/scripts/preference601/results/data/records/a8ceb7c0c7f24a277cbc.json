 "record": {
  "scenario": "D2",
  "kind": "durable",
  "labels": {
   "purpose": "The user asks to leave out emoji and says they cannot stand emoji in anything written for them or in their name.",
   "preference": "The user does not want emoji in anything written for them or in their name; they find emoji unprofessional.",
   "expected_scope": "global",
   "polarity": "No emoji. A fact that limits it to the offsite announcement or to this chat only is too narrow.",
   "acknowledged_if": "The second answer recognises the request (says it will leave emoji out, or the rewritten text visibly drops them and says so).",
   "probe_applied_if": "The probe message contains no emoji (pictographic symbols such as a plant, sparkles or a party popper).",
   "probe_partial_if": "One emoji is left in an otherwise emoji-free text."
  },
  "prompts": {
   "turn1": "Write a short announcement for the team chat about the offsite, using notes.md.",
   "turn2": "Looks fine, but please leave out the emoji. I can't stand them in anything written for me or in my name; to me they read as unprofessional. Can you also make a two-line reminder for the day before?"
  },
  "answers": {
   "turn1": "Here's a draft for the team chat:\n\n---\n\n📣 **Team offsite: Thursday, Nov 19**\n\nWe're heading to the Millpond Barn (14 Weir Lane) from 10:00 to 17:00.\n\n🚌 The bus leaves the office at **09:15** and we'll be back by 18:00.\n🍽️ Lunch is provided. Please tell **Odile Varga** about any dietary needs by **Friday, Nov 13**.\n💻 Bring your laptop. We have a planning session in the afternoon.\n\nSee you there!\n\n---\n\nThe notes call the venue \"invented\", so check that it's a real place before you post.",
   "turn2": "I've saved the no-emoji rule to memory, so it will apply to future drafts too.\n\nAnnouncement without emoji:\n\n---\n\n**Team offsite: Thursday, Nov 19**\n\nWe're heading to the Millpond Barn (14 Weir Lane) from 10:00 to 17:00.\n\n- The bus leaves the office at **09:15** and we'll be back by 18:00.\n- Lunch is provided. Please tell **Odile Varga** about any dietary needs by **Friday, Nov 13**.\n- Bring your laptop. We have a planning session in the afternoon.\n\nSee you there!\n\n---\n\nReminder for Wednesday, Nov 18:\n\n---\n\nReminder: the offsite is tomorrow. The bus leaves the office at 09:15 sharp, and please bring your laptop for the afternoon planning session.\nLunch is provided, and we'll be back by 18:00.\n\n---\n\nThe Nov 13 dietary deadline will have passed by then, so I left it out of the reminder."
  },
  "base_changes": [
   {
    "id": "01M6EK3MBRJTW6BC6ED6238433",
    "change": "added",
    "version": 1,
    "kind": "rule",
    "scope": "global",
    "source": "user",
    "expires": "",
    "content": "Never use emoji in anything written for the user or in their name (announcements, messages, drafts). The user finds them unprofessional.",
    "keywords": [
     "emoji",
     "эмодзи",
     "smileys",
     "tone",
     "writing style",
     "announcements",
     "drafts"
    ]
   }
  ],
  "memcue_calls": [
