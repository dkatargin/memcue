 "record": {
  "scenario": "D2",
  "kind": "durable",
  "labels": {
   "purpose": "The user asks to leave out emoji and says they cannot stand emoji in anything written for them or in their name.",
   "preference": "The user does not want emoji in anything written for them or in their name; they find emoji unprofessional.",
   "expected_scope": "global",
   "polarity": "No emoji. A fact that limits it to the offsite announcement or to this chat only is too narrow.",
   "acknowledged_if": "The second answer recognises the request (says it will leave emoji out, or the rewritten text visibly drops them and says so).",
   "probe_applied_if": "The probe message contains no emoji (pictographic symbols such as a plant, sparkles or a party popper).",
   "probe_partial_if": "One emoji is left in an otherwise emoji-free text."
  },
  "prompts": {
   "turn1": "Write a short announcement for the team chat about the offsite, using notes.md.",
   "turn2": "Looks fine, but please leave out the emoji. I can't stand them in anything written for me or in my name; to me they read as unprofessional. Can you also make a two-line reminder for the day before?"
  },
  "answers": {
   "turn1": "📣 **Team offsite: Thursday 19 Nov**\n\n- **When:** 10:00–17:00\n- **Where:** the Millpond Barn, 14 Weir Lane\n- **Bus:** leaves the office at 09:15 and gets us back by 18:00\n- **Lunch:** provided. Please tell Odile Varga about any dietary needs by **Friday 13 Nov**.\n- **Bring:** a laptop for the afternoon planning session\n\nSee you there!",
   "turn2": "Here is the announcement without the emoji:\n\n**Team offsite: Thursday 19 Nov**\n\n- **When:** 10:00–17:00\n- **Where:** the Millpond Barn, 14 Weir Lane\n- **Bus:** leaves the office at 09:15 and gets us back by 18:00\n- **Lunch:** provided. Please tell Odile Varga about any dietary needs by **Friday 13 Nov**.\n- **Bring:** a laptop for the afternoon planning session\n\nSee you there!\n\nHere is the reminder for Wednesday 18 Nov:\n\nReminder: the offsite is tomorrow, Thursday 19 Nov. The bus leaves the office at 09:15 sharp, so please be there by 09:10.\nBring a laptop for the afternoon planning session. The venue is the Millpond Barn, 14 Weir Lane.\n\nThe notes don't give a \"be there by\" time, so I made up 09:10. Change or drop it if you like.\n\nI've saved your no-emoji preference to memory, so I'll apply it to future writing too."
  },
  "base_changes": [
   {
    "id": "01M6EK61W79KWZ7JDZ6D8D631F",
    "change": "added",
    "version": 1,
    "kind": "rule",
    "scope": "global",
    "source": "user",
    "expires": "",
    "content": "Never use emoji in anything written for the user or in their name (chat announcements, messages, drafts); the user finds them unprofessional.",
