{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${PLUGIN_ROOT}/scripts/memcue.py\" hook",
            "timeout": 30,
            "additionalContextLimit": 5000,
            "statusMessage": "Loading memcue policy and maintenance hints"
          }
        ]
      }
    ]
  }
}
